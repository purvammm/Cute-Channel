# Copy this file to `.env` (gitignored) and fill in only what you need right now.
# Never paste real tokens into chat, issues, PRs or screenshots. For GitHub Actions use
# repository secrets instead (docs/SETUP_SECRETS.md). `python cc.py doctor` shows which values
# are set without ever printing them.

# --- Local tool overrides (optional; doctor finds standard installs by itself) ---------------
# Example: CC_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
CC_BLENDER=
CC_FFMPEG=
CC_FFPROBE=

# --- Phase 4/8, optional and PAID: let `cc.py new-episode` / `cc.py ideas` call an LLM directly.
# Leave empty to use the free path (the CLI prints a prompt you paste into any AI chat).
ANTHROPIC_API_KEY=

# --- Phase 9: Instagram publishing (names may change after the Phase 9 API research) --------
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- Phase 9: YouTube publishing (OAuth "installed app" credentials) -------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
