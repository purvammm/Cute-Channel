# Pinned tool versions: the single source of truth for scripts/setup_env.sh and `cc.py doctor`.
# Checked on 2 Oct 2026 against the official Blender mirrors; the SHA-256 sums come from
# blender-<version>.sha256 and matched on two independent mirrors.

# Blender 5.2 LTS (released 15 Sept 2026, supported to July 2028): Linux, Windows, Apple Silicon.
BLENDER_SERIES=5.2
BLENDER_VERSION=5.2.2
BLENDER_LINUX_SHA256=84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168
BLENDER_MACOS_ARM64_SHA256=dc4125399b8bfefe283cc1624d6cfc7809d1cac20ace51072127eb371f31f210
BLENDER_WINDOWS_X64_ZIP_SHA256=3849d17a682cba006075aaa3f3597ecb5c9c30ec31035b2e092c53e40679b535

# Intel Macs can't run Blender 5.x (guide §3.1), so they get the 4.5 LTS line.
BLENDER_INTEL_MAC_SERIES=4.5
BLENDER_INTEL_MAC_VERSION=4.5.14
BLENDER_INTEL_MAC_SHA256=613e73339e97bd113adeeb28d9155beeacf2df7119ee4dbd6bdce234843645f6

# download.blender.org challenges scripted downloads (Cloudflare), so setup uses official
# mirrors. The SHA-256 check above makes the choice of mirror safe.
BLENDER_MIRRORS="https://mirror.clarkson.edu/blender/release https://ftp.nluug.nl/pub/graphics/blender/release https://ftp.halifax.rwth-aachen.de/blender/release"

PYTHON_MIN=3.10
